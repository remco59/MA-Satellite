<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="MaSatellite.App.Views.MiniPlayerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Padding="16" RowSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Artwork + text -->
    <Grid Grid.Row="0" ColumnSpacing="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="96" Height="96" CornerRadius="8" Background="{ThemeResource ControlFillColorSecondaryBrush}">
        <Grid>
          <FontIcon Glyph="&#xE8D6;" FontSize="36" Opacity="0.5" />
          <Image x:Name="ArtworkImage" Stretch="UniformToFill" />
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
        <TextBlock x:Name="ArtistText" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="AlbumText" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="StatusText" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Grid>

    <!-- Progress -->
    <Grid Grid.Row="1" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="ElapsedText" Text="0:00" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
      <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" IsThumbToolTipEnabled="False" ValueChanged="OnSeekChanged" />
      <TextBlock x:Name="TotalText" Grid.Column="2" Text="0:00" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
    </Grid>

    <!-- Transport -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
      <Button x:Name="PrevButton" Click="OnPrevious" ToolTipService.ToolTip="Previous">
        <FontIcon Glyph="&#xE892;" />
      </Button>
      <Button x:Name="PlayPauseButton" Click="OnPlayPause" Style="{StaticResource AccentButtonStyle}" Width="56" ToolTipService.ToolTip="Play / pause">
        <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" />
      </Button>
      <Button x:Name="NextButton" Click="OnNext" ToolTipService.ToolTip="Next">
        <FontIcon Glyph="&#xE893;" />
      </Button>
    </StackPanel>

    <!-- Volume (the Windows master volume) -->
    <Grid Grid.Row="3" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="40" />
      </Grid.ColumnDefinitions>
      <Button x:Name="MuteButton" Click="OnMute" Padding="8,6" ToolTipService.ToolTip="Mute">
        <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" />
      </Button>
      <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="OnVolumeChanged" />
      <TextBlock x:Name="VolumeText" Grid.Column="2" Text="0" VerticalAlignment="Center" HorizontalTextAlignment="End" />
    </Grid>

    <!-- Output + settings -->
    <Grid Grid.Row="4" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="DeviceBox" HorizontalAlignment="Stretch" SelectionChanged="OnDeviceChanged" ToolTipService.ToolTip="Output device" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <Button Click="OnOpenLibrary" ToolTipService.ToolTip="Library">
          <FontIcon Glyph="&#xE8F1;" />
        </Button>
        <Button Click="OnOpenSettings" ToolTipService.ToolTip="Settings">
          <FontIcon Glyph="&#xE713;" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
