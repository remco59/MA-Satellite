<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="MaSatellite.App.Views.MiniPlayerWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Padding="18" RowSpacing="14" Background="{StaticResource AuroraBackground}" RequestedTheme="Dark">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Background="{StaticResource AuroraAccentGradient}" CornerRadius="5" Width="19" Height="19">
          <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D6;" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="MA-Satellite" FontWeight="Bold" Foreground="{StaticResource AuroraText}" FontSize="14" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="NOW PLAYING" Foreground="{StaticResource AuroraMuted}" FontSize="10" CharacterSpacing="100" VerticalAlignment="Center"/>
    </Grid>
    <!-- Long SoundCloud descriptions are always constrained to a single line. -->
    <Border Grid.Row="1" Background="{StaticResource AuroraCardSoft}" BorderBrush="{StaticResource AuroraBorder}" BorderThickness="1" Padding="12" CornerRadius="15">
      <Grid ColumnSpacing="14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="96" Height="96" CornerRadius="12" Background="{StaticResource AuroraHeroGradient}">
          <Grid>
            <FontIcon Glyph="&#xE8D6;" FontSize="32" Foreground="{StaticResource AuroraMuted}" Opacity="0.6"/>
            <Image x:Name="ArtworkImage" Stretch="UniformToFill"/>
          </Grid>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
          <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AuroraText}"
                     TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2"/>
          <TextBlock x:Name="ArtistText" FontSize="13" Foreground="{StaticResource AuroraMuted}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
          <TextBlock x:Name="AlbumText" FontSize="11" Foreground="{StaticResource AuroraMuted}" Opacity="0.8"
                     TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2" RowSpacing="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" IsThumbToolTipEnabled="False" ValueChanged="OnSeekChanged"/>
      <Grid Grid.Row="1">
        <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="{StaticResource AuroraMuted}" FontSize="11"/>
        <TextBlock x:Name="TotalText" Text="0:00" Foreground="{StaticResource AuroraMuted}" FontSize="11" HorizontalAlignment="Right"/>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
      <Button x:Name="PrevButton" Click="OnPrevious" Style="{StaticResource AuroraIconButtonStyle}"
              Foreground="{StaticResource AuroraText}" ToolTipService.ToolTip="Previous track"
              AutomationProperties.Name="Previous track">
        <FontIcon Glyph="&#xE892;" FontSize="16"/>
      </Button>
      <Button x:Name="PlayPauseButton" Click="OnPlayPause" Style="{StaticResource AuroraPlayButtonStyle}"
              ToolTipService.ToolTip="Play or pause" AutomationProperties.Name="Play or pause">
        <Grid Width="28" Height="28">
          <Ellipse x:Name="PlayPauseTrack" Visibility="Collapsed" Width="26" Height="26"
                   Stroke="#B3A8FF" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <ProgressRing x:Name="PlayPauseSpinner" IsActive="False" Visibility="Collapsed"
                        Foreground="White" Width="28" Height="28"/>
        </Grid>
      </Button>
      <Button x:Name="NextButton" Click="OnNext" Style="{StaticResource AuroraIconButtonStyle}"
              Foreground="{StaticResource AuroraText}" ToolTipService.ToolTip="Next track"
              AutomationProperties.Name="Next track">
        <FontIcon Glyph="&#xE893;" FontSize="16"/>
      </Button>
    </StackPanel>
    <Grid Grid.Row="4" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="36"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="MuteButton" Click="OnMute" Style="{StaticResource AuroraIconButtonStyle}"
              ToolTipService.ToolTip="Mute or unmute" AutomationProperties.Name="Mute or unmute">
        <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" FontSize="16"/>
      </Button>
      <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="OnVolumeChanged"
              AutomationProperties.Name="System volume" VerticalAlignment="Center"/>
      <TextBlock x:Name="VolumeText" Grid.Column="2" Text="0" VerticalAlignment="Center"
                 HorizontalTextAlignment="End" Foreground="{StaticResource AuroraMuted}" FontSize="12"/>
    </Grid>
    <Grid Grid.Row="5" ColumnSpacing="9" RowSpacing="10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="DeviceBox" HorizontalAlignment="Stretch" MinWidth="195" SelectionChanged="OnDeviceChanged"
                ToolTipService.ToolTip="Windows audio output" AutomationProperties.Name="Output device"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <Button Click="OnOpenLibrary" ToolTipService.ToolTip="Open Music Assistant library"
                AutomationProperties.Name="Open library" Style="{StaticResource AuroraIconButtonStyle}">
          <FontIcon Glyph="&#xE8F1;" FontSize="16"/>
        </Button>
        <Button Click="OnOpenSettings" ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings"
                Style="{StaticResource AuroraIconButtonStyle}">
          <FontIcon Glyph="&#xE713;" FontSize="16"/>
        </Button>
      </StackPanel>
      <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="2" MaxLines="1" AutomationProperties.LiveSetting="Polite"
                 TextTrimming="CharacterEllipsis" Foreground="{StaticResource AuroraGood}" FontSize="11"/>
    </Grid>
  </Grid>
</Window>