<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="MaSatellite.App.Views.FeaturedCard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Large featured playlist: full-bleed artwork, a scrim for legibility, one primary action and shuffle. -->
  <Grid x:Name="Root" Height="216" CornerRadius="20">
    <Rectangle x:Name="Backdrop" RadiusX="20" RadiusY="20" Fill="{StaticResource AuroraHeroGradient}"/>
    <Rectangle RadiusX="20" RadiusY="20" Fill="{StaticResource AuroraScrim}"/>
    <Button x:Name="SurfaceButton" Click="OnOpen" Style="{StaticResource AuroraSurfaceButtonStyle}" CornerRadius="20"/>
    <Grid Padding="28" RowSpacing="14">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="440" IsHitTestVisible="False">
        <TextBlock x:Name="EyebrowText" Style="{StaticResource AuroraSectionLabelStyle}" Foreground="#D4CCFF"/>
        <TextBlock x:Name="TitleText" FontSize="32" FontWeight="Bold" Foreground="White"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"/>
        <TextBlock x:Name="DescriptionText" FontSize="14" Foreground="#D9DEF2" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" MaxLines="2"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
        <Button x:Name="PlayButton" Click="OnPlay" Style="{StaticResource AuroraPrimaryButtonStyle}" CornerRadius="22" MinHeight="44"
                Padding="22,0" AutomationProperties.Name="Play">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE768;" FontSize="14"/><TextBlock Text="Play" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="ShuffleButton" Click="OnShuffle" Style="{StaticResource AuroraPillButtonStyle}"
                Background="#33FFFFFF" Width="44" Padding="0" MinHeight="44" ToolTipService.ToolTip="Shuffle play"
                AutomationProperties.Name="Shuffle play">
          <FontIcon Glyph="&#xE8B1;" FontSize="15"/>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
