<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="MaSatellite.App.Views.FeaturedCard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Large featured playlist: full-bleed artwork, a scrim for legibility, one primary action and shuffle. -->
  <Grid x:Name="Root" Height="252" CornerRadius="{StaticResource AuroraRadiusL}">
    <Rectangle x:Name="Backdrop" RadiusX="20" RadiusY="20" Fill="{StaticResource AuroraHeroGradient}"/>
    <Rectangle RadiusX="20" RadiusY="20" Fill="{StaticResource AuroraScrim}"/>
    <Rectangle RadiusX="20" RadiusY="20" Fill="{StaticResource AuroraAtmosphereGradient}" IsHitTestVisible="False"/>
    <Button x:Name="SurfaceButton" Click="OnOpen" Style="{StaticResource AuroraSurfaceButtonStyle}" CornerRadius="{StaticResource AuroraRadiusL}"/>
    <Grid Padding="32" RowSpacing="14">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="440" IsHitTestVisible="False">
        <TextBlock x:Name="EyebrowText" Style="{StaticResource AuroraSectionLabelStyle}" Foreground="{StaticResource AuroraAccentLight}"/>
        <TextBlock x:Name="TitleText" FontSize="32" FontWeight="SemiBold" Foreground="White"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"/>
        <TextBlock x:Name="DescriptionText" FontSize="14" Foreground="{StaticResource AuroraTextOnArt}" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" MaxLines="2"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
        <Button x:Name="PlayButton" Click="OnPlay" Style="{StaticResource AuroraPrimaryButtonStyle}" CornerRadius="22" MinHeight="44"
                Padding="22,0" AutomationProperties.Name="Play">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE768;" FontSize="16"/><TextBlock Text="Play" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="ShuffleButton" Click="OnShuffle" Style="{StaticResource AuroraButtonStyle}"
                Background="{StaticResource AuroraGlass}" CornerRadius="22" Width="44" Padding="0" MinHeight="44" ToolTipService.ToolTip="Shuffle play"
                AutomationProperties.Name="Shuffle play">
          <FontIcon Glyph="&#xE8B1;" FontSize="16"/>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
