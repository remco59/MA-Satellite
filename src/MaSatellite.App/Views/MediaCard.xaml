<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="MaSatellite.App.Views.MediaCard"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Standard / compact card. Artwork is the focus; play and menu appear on hover or keyboard focus. -->
  <Grid x:Name="Root" Padding="12" CornerRadius="14" Background="Transparent" RowSpacing="10" HorizontalAlignment="Center"
        PointerEntered="OnPointerEntered" PointerExited="OnPointerExited"
        GotFocus="OnGotFocus" LostFocus="OnLostFocus" RightTapped="OnRightTapped">
    <Grid.BackgroundTransition>
      <BrushTransition Duration="0:0:0.15"/>
    </Grid.BackgroundTransition>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="ArtHost" Width="164" Height="164">
      <Rectangle RadiusX="10" RadiusY="10" Fill="{StaticResource AuroraHeroGradient}"/>
      <FontIcon x:Name="Placeholder" Glyph="&#xE8D6;" FontSize="34" Foreground="{StaticResource AuroraMuted}" Opacity="0.5"/>
      <Rectangle x:Name="ArtRect" RadiusX="10" RadiusY="10"/>
      <Button x:Name="MenuButton" Click="OnMenuClick" Style="{StaticResource AuroraIconButtonStyle}"
              Background="#99000000" Foreground="White" Width="32" Height="32" MinHeight="32" CornerRadius="16"
              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Opacity="0"
              ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
        <Button.OpacityTransition><ScalarTransition Duration="0:0:0.15"/></Button.OpacityTransition>
        <FontIcon Glyph="&#xE712;" FontSize="14"/>
      </Button>
      <Button x:Name="PlayButton" Click="OnPlayClick" Style="{StaticResource AuroraPlayButtonStyle}"
              Width="40" Height="40" MinHeight="40" CornerRadius="20"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Opacity="0"
              ToolTipService.ToolTip="Play now" AutomationProperties.Name="Play now">
        <Button.OpacityTransition><ScalarTransition Duration="0:0:0.15"/></Button.OpacityTransition>
        <Button.TranslationTransition><Vector3Transition Duration="0:0:0.18"/></Button.TranslationTransition>
        <FontIcon Glyph="&#xE768;" FontSize="16"/>
      </Button>
    </Grid>
    <StackPanel x:Name="TextHost" Grid.Row="1" Spacing="2" Width="164">
      <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AuroraText}"
                 TextTrimming="CharacterEllipsis" MaxLines="1"/>
      <TextBlock x:Name="SubtitleText" Style="{StaticResource AuroraSubtitleStyle}" FontSize="12" MaxLines="1"/>
    </StackPanel>
  </Grid>
</UserControl>
