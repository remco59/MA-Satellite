<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="MaSatellite.App.Views.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="{StaticResource AuroraBackground}" RequestedTheme="Dark">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{StaticResource AuroraSidebarGradient}" BorderBrush="{StaticResource AuroraBorder}" BorderThickness="0,0,0,1" Padding="28,25">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="5">
          <TextBlock Text="Settings" Style="{StaticResource AuroraTitleStyle}"/>
          <TextBlock Text="Make ma·satellite sound and behave the way you want." Style="{StaticResource AuroraSubtitleStyle}"/>
        </StackPanel>
        <Border Grid.Column="1" Padding="12,6" CornerRadius="14" Background="{StaticResource AuroraCard}" BorderBrush="{StaticResource AuroraBorder}" BorderThickness="1" VerticalAlignment="Center">
          <TextBlock Text="MA · SATELLITE" FontSize="11" CharacterSpacing="90" FontWeight="SemiBold" Foreground="{StaticResource AuroraAccent}"/>
        </Border>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Padding="28,24,28,28" Spacing="16">
        <!-- Live connection status is actual Sendspin host data. -->
        <Border Style="{StaticResource AuroraCardStyle}" Background="{StaticResource AuroraHeroGradient}">
          <StackPanel Spacing="6">
            <TextBlock Text="CONNECTION STATUS" Style="{StaticResource AuroraSectionLabelStyle}"/>
            <TextBlock x:Name="StatusLine" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AuroraText}" TextWrapping="Wrap"/>
            <TextBlock x:Name="NowPlayingLine" Foreground="{StaticResource AuroraText}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
            <TextBlock x:Name="SecurityLine" Style="{StaticResource AuroraSubtitleStyle}" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Grid ColumnSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <!-- Basic player settings -->
          <Border Grid.Column="0" Style="{StaticResource AuroraCardStyle}">
            <StackPanel Spacing="13">
              <StackPanel Spacing="4">
                <TextBlock Text="Player &amp; output" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AuroraText}"/>
                <TextBlock Text="Identity, speakers and startup." Style="{StaticResource AuroraSubtitleStyle}"/>
              </StackPanel>
              <TextBox x:Name="PlayerNameBox" Header="Player name" MaxLength="64"/>
              <ComboBox x:Name="DeviceBox" Header="Output device" HorizontalAlignment="Stretch"/>
              <ToggleSwitch x:Name="AutostartSwitch" Header="Start with Windows"/>
            </StackPanel>
          </Border>
          <!-- Library API and server -->
          <Border Grid.Column="1" Style="{StaticResource AuroraCardStyle}">
            <StackPanel Spacing="13">
              <StackPanel Spacing="4">
                <TextBlock Text="Music Assistant" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AuroraText}"/>
                <TextBlock Text="Connect and browse your library." Style="{StaticResource AuroraSubtitleStyle}"/>
              </StackPanel>
              <TextBox x:Name="HostBox" Header="Server address" PlaceholderText="192.168.0.98"/>
              <NumberBox x:Name="MaPortBox" Header="Music Assistant web port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden"/>
              <PasswordBox x:Name="TokenBox" Header="Library access token" PlaceholderText="Paste a long-lived token"/>
              <TextBlock x:Name="TokenStatus" Style="{StaticResource AuroraSubtitleStyle}" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Test connection" Click="OnTestConnection" Style="{StaticResource AuroraPrimaryButtonStyle}"/>
                <Button x:Name="RemoveTokenButton" Content="Remove token" Click="OnRemoveToken" Style="{StaticResource AuroraButtonStyle}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Border Style="{StaticResource AuroraCardStyle}">
          <StackPanel Spacing="13">
            <StackPanel Spacing="4">
              <TextBlock Text="Playback &amp; sync" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AuroraText}"/>
              <TextBlock Text="Streaming protocol and latency adjustments." Style="{StaticResource AuroraSubtitleStyle}"/>
            </StackPanel>
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="ProtocolBox" Header="Sendspin protocol" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Automatic (encrypted, legacy for older servers)"/>
                <ComboBoxItem Content="Encrypted only"/>
                <ComboBoxItem Content="Legacy (plain text) only"/>
              </ComboBox>
              <NumberBox x:Name="DelayBox" Grid.Column="1" Header="Static delay (ms)" Minimum="0" Maximum="5000" SpinButtonPlacementMode="Compact"/>
            </Grid>
          </StackPanel>
        </Border>

        <Expander Header="Security &amp; pairing" HorizontalAlignment="Stretch">
          <StackPanel Padding="16,18" Spacing="15">
            <TextBlock Text="Control which Music Assistant servers can access your player." Style="{StaticResource AuroraSubtitleStyle}" TextWrapping="Wrap"/>
            <ToggleSwitch x:Name="UnpairedSwitch" Header="Allow servers that are not paired to play audio"/>
            <TextBox x:Name="PairingTokenBox" Header="Pairing token" IsReadOnly="True" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Copy token" Click="OnCopyPairingToken" Style="{StaticResource AuroraButtonStyle}"/>
              <Button Content="Generate new token" Click="OnNewPairingToken" Style="{StaticResource AuroraButtonStyle}"/>
            </StackPanel>
            <ComboBox x:Name="PairedBox" Header="Paired servers" HorizontalAlignment="Stretch"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="UnpairButton" Content="Forget selected server" Click="OnUnpair" Style="{StaticResource AuroraButtonStyle}"/>
              <TextBlock x:Name="PairedStatus" VerticalAlignment="Center" Style="{StaticResource AuroraSubtitleStyle}" TextWrapping="Wrap" MaxWidth="320"/>
            </StackPanel>
          </StackPanel>
        </Expander>
        <Expander Header="Advanced · Network &amp; diagnostics" HorizontalAlignment="Stretch">
          <StackPanel Padding="16,18" Spacing="14">
            <TextBlock Text="These options are normally best left at their defaults." Style="{StaticResource AuroraSubtitleStyle}"/>
            <ComboBox x:Name="ModeBox" Header="Connection mode" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Advertise on the network (server connects to me)"/>
              <ComboBoxItem Content="Connect to the Music Assistant host"/>
            </ComboBox>
            <NumberBox x:Name="ListenPortBox" Header="Sendspin listen port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden"/>
            <ToggleSwitch x:Name="ApiSwitch" Header="Local API for desktop widgets (127.0.0.1 only)"/>
            <NumberBox x:Name="ApiPortBox" Header="Local API port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden"/>
            <TextBlock Text="LIVE DIAGNOSTICS" Style="{StaticResource AuroraSectionLabelStyle}"/>
            <TextBlock x:Name="DiagnosticsLine" Style="{StaticResource AuroraSubtitleStyle}" TextWrapping="Wrap"/>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Padding="24,14" Background="{StaticResource AuroraSidebar}" BorderBrush="{StaticResource AuroraBorder}" BorderThickness="0,1,0,0">
      <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" VerticalAlignment="Center"/>
        <Button x:Name="SaveButton" Grid.Column="1" Content="Save settings" Style="{StaticResource AuroraPrimaryButtonStyle}" Click="OnSave" MinWidth="142" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>