<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="MaSatellite.App.Views.SettingsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Spacing="14" Padding="24">
      <TextBlock Text="ma-satellite" Style="{StaticResource TitleTextBlockStyle}" />

      <Border CornerRadius="6" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="4">
          <TextBlock x:Name="StatusLine" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
          <TextBlock x:Name="NowPlayingLine" TextWrapping="Wrap" />
          <TextBlock x:Name="DiagnosticsLine" Opacity="0.7" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBox x:Name="PlayerNameBox" Header="Player name" MaxLength="64" />

      <ComboBox x:Name="DeviceBox" Header="Output device" HorizontalAlignment="Stretch" />

      <TextBox x:Name="HostBox" Header="Music Assistant host" PlaceholderText="192.168.0.98" />

      <NumberBox x:Name="MaPortBox" Header="Music Assistant web port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden" />

      <PasswordBox x:Name="TokenBox" Header="Music Assistant access token (for the library)" PlaceholderText="Paste a long-lived token" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Test connection" Click="OnTestConnection" />
        <Button x:Name="RemoveTokenButton" Content="Remove saved token" Click="OnRemoveToken" />
        <TextBlock x:Name="TokenStatus" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>

      <ComboBox x:Name="ModeBox" Header="Connection" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="Advertise on the network (server connects to me)" />
        <ComboBoxItem Content="Connect to the Music Assistant host" />
      </ComboBox>

      <NumberBox x:Name="ListenPortBox" Header="Listen port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden" />

      <NumberBox x:Name="DelayBox" Header="Static delay (ms)" Minimum="0" Maximum="5000" SpinButtonPlacementMode="Compact" />

      <ToggleSwitch x:Name="AutostartSwitch" Header="Start with Windows" />

      <ToggleSwitch x:Name="ApiSwitch" Header="Local API for desktop widgets (127.0.0.1 only)" />
      <NumberBox x:Name="ApiPortBox" Header="Local API port" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden" />

      <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" />

      <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSave" />
    </StackPanel>
  </ScrollViewer>
</Window>
