<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="MaSatellite.App.Views.LibraryWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:MaSatellite.App.Views">
  <Grid Padding="16" RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Search + target player -->
    <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="260" />
      </Grid.ColumnDefinitions>
      <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search Music Assistant" QueryIcon="Find" QuerySubmitted="OnSearchSubmitted" />
      <ComboBox x:Name="TargetBox" Grid.Column="1" HorizontalAlignment="Stretch" PlaceholderText="Play on…" SelectionChanged="OnTargetChanged" />
    </Grid>

    <SelectorBar x:Name="Tabs" Grid.Row="1" SelectionChanged="OnTabChanged">
      <SelectorBarItem Text="Albums" Tag="album" IsSelected="True" />
      <SelectorBarItem Text="Artists" Tag="artist" />
      <SelectorBarItem Text="Playlists" Tag="playlist" />
      <SelectorBarItem Text="Tracks" Tag="track" />
      <SelectorBarItem Text="Search" Tag="search" />
      <SelectorBarItem Text="Queue" Tag="queue" />
    </SelectorBar>

    <InfoBar x:Name="Message" Grid.Row="2" IsOpen="False" IsClosable="True">
      <InfoBar.ActionButton>
        <Button x:Name="SetupButton" Content="Open settings" Click="OnOpenSettings" Visibility="Collapsed" />
      </InfoBar.ActionButton>
    </InfoBar>

    <!-- Context bar: back + title + play actions for the opened album/artist/playlist, or queue actions -->
    <Grid x:Name="ContextBar" Grid.Row="3" ColumnSpacing="8" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="BackButton" Click="OnBack" ToolTipService.ToolTip="Back">
        <FontIcon Glyph="&#xE72B;" />
      </Button>
      <TextBlock x:Name="ContextTitle" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
      <StackPanel x:Name="ContextActions" Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Content="Play" Style="{StaticResource AccentButtonStyle}" Click="OnContextPlay" />
        <Button Content="Play next" Click="OnContextPlayNext" />
        <Button Content="Add to queue" Click="OnContextAdd" />
      </StackPanel>
    </Grid>

    <!-- Queue toolbar (shown on the Queue tab) -->
    <StackPanel x:Name="QueueBar" Grid.Row="3" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
      <Button Click="OnQueuePrevious" ToolTipService.ToolTip="Previous"><FontIcon Glyph="&#xE892;" /></Button>
      <Button Click="OnQueuePlayPause" ToolTipService.ToolTip="Play / pause"><FontIcon Glyph="&#xE768;" /></Button>
      <Button Click="OnQueueNext" ToolTipService.ToolTip="Next"><FontIcon Glyph="&#xE893;" /></Button>
      <TextBlock Text="Move this queue to" VerticalAlignment="Center" Margin="16,0,0,0" />
      <ComboBox x:Name="TransferBox" Width="220" PlaceholderText="Player…" />
      <Button Content="Transfer" Click="OnTransfer" />
    </StackPanel>

    <ProgressRing x:Name="Busy" Grid.Row="4" IsActive="False" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <TextBlock x:Name="EmptyText" Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" Visibility="Collapsed" />

    <ListView x:Name="List" Grid.Row="4" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnItemClick">
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:ListRow">
          <Grid Padding="4,6" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
              <Grid>
                <FontIcon Glyph="&#xE8D6;" Opacity="0.4" Visibility="{x:Bind PlaceholderVisibility}" />
                <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" FontWeight="{x:Bind Weight}" />
              <TextBlock Text="{x:Bind Subtitle}" Opacity="0.65" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Tag="{x:Bind}" Click="OnRowMenu" Visibility="{x:Bind MenuVisibility}" ToolTipService.ToolTip="Play options" VerticalAlignment="Center">
              <FontIcon Glyph="&#xE712;" FontSize="14" />
            </Button>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Window>
