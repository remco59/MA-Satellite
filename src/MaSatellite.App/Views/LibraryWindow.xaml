<?xml version="1.0" encoding="utf-8"?>
<Window
  x:Class="MaSatellite.App.Views.LibraryWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:MaSatellite.App.Views"
  xmlns:host="using:MaSatellite.Host.Presentation">
  <Grid x:Name="LibraryRoot" Background="{StaticResource AuroraBackground}" RequestedTheme="Dark" SizeChanged="OnLibrarySizeChanged">
    <Grid.Resources>
      <!-- One card template for every grid and shelf, so albums, artists, tracks and playlists look the same. -->
      <DataTemplate x:Key="CardTemplate" x:DataType="local:ListRow">
        <local:MediaCard Row="{x:Bind}" PlayRequested="OnCardPlay" MenuRequested="OnRowMenu"/>
      </DataTemplate>
      <DataTemplate x:Key="CompactCardTemplate" x:DataType="local:ListRow">
        <local:MediaCard Row="{x:Bind}" ArtSize="140" PlayRequested="OnCardPlay" MenuRequested="OnRowMenu"/>
      </DataTemplate>
      <DataTemplate x:Key="RowTemplate" x:DataType="local:ListRow">
        <local:MediaRow Row="{x:Bind}" PlayRequested="OnCardPlay" MenuRequested="OnRowMenu"/>
      </DataTemplate>
      <!-- Wide artwork tile (Picked for you): the cover fills the tile, a scrim keeps the title legible. -->
      <DataTemplate x:Key="WideTileTemplate" x:DataType="local:ListRow">
        <Grid Width="248" Height="124" Margin="6" CornerRadius="16" ToolTipService.ToolTip="{x:Bind Title}">
          <Rectangle Fill="{StaticResource AuroraHeroGradient}"/>
          <Rectangle><Rectangle.Fill><ImageBrush ImageSource="{x:Bind Image}" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle>
          <Rectangle><Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#000A0A12" Offset="0.2"/><GradientStop Color="#E60A0A12" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill></Rectangle>
          <StackPanel VerticalAlignment="Bottom" Padding="14,0,14,12" Spacing="1">
            <TextBlock Text="{x:Bind Title}" Style="{StaticResource AuroraItemTitleStyle}" Foreground="White" MaxLines="1"/>
            <TextBlock Text="{x:Bind CardSubtitle}" Style="{StaticResource AuroraMetaStyle}" Foreground="#D6D3E8" MaxLines="1"/>
          </StackPanel>
        </Grid>
      </DataTemplate>
      <!-- Compact horizontal tile (Continue listening): small cover, title, one meta line. -->
      <DataTemplate x:Key="TileTemplate" x:DataType="local:ListRow">
        <Grid Width="272" Height="72" Margin="6" Padding="8" ColumnSpacing="12" CornerRadius="14"
              Background="{StaticResource AuroraCardSoft}" BorderBrush="{StaticResource AuroraBorder}" BorderThickness="1"
              ToolTipService.ToolTip="{x:Bind Title}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid Width="54" Height="54">
            <Rectangle RadiusX="9" RadiusY="9" Fill="{StaticResource AuroraCard}"/>
            <Rectangle RadiusX="9" RadiusY="9"><Rectangle.Fill><ImageBrush ImageSource="{x:Bind Image}" Stretch="UniformToFill"/></Rectangle.Fill></Rectangle>
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{x:Bind Title}" Style="{StaticResource AuroraItemTitleStyle}" MaxLines="1"/>
            <TextBlock Text="{x:Bind CardSubtitle}" Style="{StaticResource AuroraMetaStyle}" MaxLines="1"/>
          </StackPanel>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="ModeTemplate" x:DataType="host:ModePick">
        <Button Click="OnModeClick" Style="{StaticResource AuroraButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,12" CornerRadius="16" Background="{StaticResource AuroraCardSoft}"
                ToolTipService.ToolTip="{x:Bind Playlist.Name}" AutomationProperties.Name="{x:Bind Mode.Label}">
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="13" Background="{StaticResource AuroraAccentSoft}">
              <FontIcon Glyph="{x:Bind Mode.Glyph}" FontSize="18" Foreground="{StaticResource AuroraAccent}"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{x:Bind Mode.Label}" Style="{StaticResource AuroraItemTitleStyle}"/>
              <TextBlock Text="{x:Bind Playlist.Name}" Style="{StaticResource AuroraMetaStyle}"/>
            </StackPanel>
          </Grid>
        </Button>
      </DataTemplate>
      <DataTemplate x:Key="ExploreTileTemplate" x:DataType="local:ExploreTile">
        <Button Click="OnExploreTile" Style="{StaticResource AuroraButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                VerticalContentAlignment="Top" Padding="18,16" CornerRadius="18" MinHeight="104" Background="{StaticResource AuroraCardSoft}"
                AutomationProperties.Name="{x:Bind Title}">
          <StackPanel Spacing="6">
            <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" Foreground="{StaticResource AuroraAccent}" HorizontalAlignment="Left"/>
            <TextBlock Text="{x:Bind Title}" Style="{StaticResource AuroraItemTitleStyle}"/>
            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource AuroraMetaStyle}" TextWrapping="Wrap" MaxLines="2"/>
          </StackPanel>
        </Button>
      </DataTemplate>
      <!-- A statistic: a number and a caption. Not clickable. -->
      <DataTemplate x:Key="StatTileTemplate" x:DataType="local:ExploreTile">
        <Border Padding="18,14" CornerRadius="16" Background="{StaticResource AuroraInput}" MinHeight="96">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Title}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource AuroraText}" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource AuroraMetaStyle}" TextWrapping="Wrap" MaxLines="2"/>
          </StackPanel>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="GenreChipTemplate" x:DataType="host:GenreCount">
        <Button Click="OnGenreClick" Style="{StaticResource AuroraButtonStyle}" HorizontalAlignment="Stretch" CornerRadius="18"
                Background="{StaticResource AuroraInput}" MinHeight="44" AutomationProperties.Name="{x:Bind Genre}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{x:Bind Genre}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
            <TextBlock Text="{x:Bind Count}" Style="{StaticResource AuroraMetaStyle}"/>
          </StackPanel>
        </Button>
      </DataTemplate>
    </Grid.Resources>
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnFocusSearch"/>
      <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="OnNavAccelerator"/>
      <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="OnNavAccelerator"/>
      <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="OnNavAccelerator"/>
      <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="OnNavAccelerator"/>
      <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackAccelerator"/>
      <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="OnForwardAccelerator"/>
    </Grid.KeyboardAccelerators>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="SidebarColumn" Width="232"/><ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Title area: the window drag region, with the app name like a native title bar. -->
    <Grid x:Name="TitleBarRegion" Grid.ColumnSpan="2" Background="Transparent">
      <StackPanel Orientation="Horizontal" Spacing="9" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
        <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource AuroraAccentGradient}">
          <FontIcon Glyph="&#xE8D6;" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="MA-Satellite" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AuroraText}"/>
      </StackPanel>
    </Grid>

    <!-- Sidebar: every item opens a real view. Labels are tagged so the collapsed state can hide them. -->
    <Border x:Name="Sidebar" Grid.Row="1" Background="{StaticResource AuroraSidebar}"
            BorderBrush="{StaticResource AuroraBorder}" BorderThickness="0,0,1,0">
      <Grid Padding="12,4,12,12" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="14">
          <Button x:Name="SidebarToggle" Click="OnToggleSidebar" Style="{StaticResource AuroraNavButtonStyle}"
                  ToolTipService.ToolTip="Collapse or expand the sidebar" AutomationProperties.Name="Collapse or expand the sidebar">
            <Grid ColumnSpacing="14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE700;" FontSize="16"/>
              <TextBlock Grid.Column="1" Tag="label" Text="Menu" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <Grid ColumnSpacing="12" Margin="4,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AuroraAccentGradient}">
              <FontIcon Glyph="&#xE8D6;" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Tag="label" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="MA-Satellite" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AuroraText}"/>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse x:Name="SidebarDot" Width="7" Height="7" Fill="{StaticResource AuroraMuted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="BrandStatus" Text="Music Assistant" FontSize="11" Foreground="{StaticResource AuroraMuted}"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="2">
            <TextBlock Tag="label" Text="DISCOVER" Margin="14,6,0,6" Style="{StaticResource AuroraSectionLabelStyle}"/>
            <Button x:Name="NavHome" Tag="home" Click="OnNavigate" Style="{StaticResource AuroraNavButtonStyle}"
                    ToolTipService.ToolTip="Home" AutomationProperties.Name="Home">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE80F;" FontSize="17"/><TextBlock Grid.Column="1" Tag="label" Text="Home" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="NavDiscover" Tag="discover" Click="OnNavigate" Style="{StaticResource AuroraNavButtonStyle}"
                    ToolTipService.ToolTip="Discover" AutomationProperties.Name="Discover">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE774;" FontSize="17"/><TextBlock Grid.Column="1" Tag="label" Text="Discover" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="NavSearch" Tag="search" Click="OnNavigate" Style="{StaticResource AuroraNavButtonStyle}"
                    ToolTipService.ToolTip="Search" AutomationProperties.Name="Search">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE721;" FontSize="17"/><TextBlock Grid.Column="1" Tag="label" Text="Search" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <TextBlock Tag="label" Text="YOUR COLLECTION" Margin="14,20,0,6" Style="{StaticResource AuroraSectionLabelStyle}"/>
            <Button x:Name="NavPlaylist" Tag="playlist" Click="OnNavigate" Style="{StaticResource AuroraNavButtonStyle}"
                    ToolTipService.ToolTip="Playlists" AutomationProperties.Name="Playlists">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE90B;" FontSize="17"/><TextBlock Grid.Column="1" Tag="label" Text="Playlists" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="NavAlbum" Tag="album" Click="OnNavigate" Style="{StaticResource AuroraNavButtonStyle}"
                    ToolTipService.ToolTip="Albums" AutomationProperties.Name="Albums">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE93C;" FontSize="17"/><TextBlock Grid.Column="1" Tag="label" Text="Albums" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="NavArtist" Tag="artist" Click="OnNavigate" Style="{StaticResource AuroraNavButtonStyle}"
                    ToolTipService.ToolTip="Artists" AutomationProperties.Name="Artists">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE77B;" FontSize="17"/><TextBlock Grid.Column="1" Tag="label" Text="Artists" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="NavTrack" Tag="track" Click="OnNavigate" Style="{StaticResource AuroraNavButtonStyle}"
                    ToolTipService.ToolTip="Tracks" AutomationProperties.Name="Tracks">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8D6;" FontSize="17"/><TextBlock Grid.Column="1" Tag="label" Text="Tracks" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <TextBlock Tag="label" Text="PLAYBACK" Margin="14,20,0,6" Style="{StaticResource AuroraSectionLabelStyle}"/>
            <Button x:Name="NavNow" Tag="now" Click="OnNavigate" Style="{StaticResource AuroraNavButtonStyle}"
                    ToolTipService.ToolTip="Now playing" AutomationProperties.Name="Now playing">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE767;" FontSize="17"/><TextBlock Grid.Column="1" Tag="label" Text="Now playing" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="NavQueue" Click="OnOpenQueue" Style="{StaticResource AuroraNavButtonStyle}"
                    ToolTipService.ToolTip="Queue" AutomationProperties.Name="Queue">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8FD;" FontSize="17"/><TextBlock Grid.Column="1" Tag="label" Text="Queue" VerticalAlignment="Center"/>
              </Grid>
            </Button>
            <Button x:Name="NavRadio" Tag="radio" Click="OnNavigate" Style="{StaticResource AuroraNavButtonStyle}"
                    ToolTipService.ToolTip="Radio" AutomationProperties.Name="Radio">
              <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE93E;" FontSize="17"/><TextBlock Grid.Column="1" Tag="label" Text="Radio" VerticalAlignment="Center"/>
              </Grid>
            </Button>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="8">
          <Border Tag="label" Background="{StaticResource AuroraCardSoft}" CornerRadius="12" Padding="12,10"
                  BorderThickness="1" BorderBrush="{StaticResource AuroraBorder}">
            <StackPanel Spacing="3">
              <TextBlock Text="Music Assistant" Foreground="{StaticResource AuroraText}" FontSize="12" FontWeight="SemiBold"/>
              <TextBlock x:Name="SidebarStatus" Text="Connecting to your library…" AutomationProperties.LiveSetting="Polite"
                         Foreground="{StaticResource AuroraMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
          <Button Click="OnOpenSettings" Style="{StaticResource AuroraNavButtonStyle}"
                  ToolTipService.ToolTip="Settings" AutomationProperties.Name="Open settings">
            <Grid ColumnSpacing="14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE713;" FontSize="17"/><TextBlock Grid.Column="1" Tag="label" Text="Settings" VerticalAlignment="Center"/>
            </Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main content -->
    <Grid x:Name="MainContent" Grid.Row="1" Grid.Column="1" Padding="28,0,28,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Top bar: history, search, output device. Nothing else. -->
      <Grid Grid.Row="0" ColumnSpacing="12" Margin="0,6,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="BackButton" Click="OnBack" IsEnabled="False" Style="{StaticResource AuroraIconButtonStyle}"
                  Background="{StaticResource AuroraInput}" ToolTipService.ToolTip="Back (Alt+Left)" AutomationProperties.Name="Back">
            <FontIcon Glyph="&#xE76B;" FontSize="14"/>
          </Button>
          <Button x:Name="ForwardButton" Click="OnForward" IsEnabled="False" Style="{StaticResource AuroraIconButtonStyle}"
                  Background="{StaticResource AuroraInput}" ToolTipService.ToolTip="Forward (Alt+Right)" AutomationProperties.Name="Forward">
            <FontIcon Glyph="&#xE76C;" FontSize="14"/>
          </Button>
        </StackPanel>
        <Border x:Name="SearchPill" Grid.Column="1" Height="44" CornerRadius="22" MaxWidth="640" HorizontalAlignment="Stretch"
                Background="{StaticResource AuroraInput}" BorderBrush="{StaticResource AuroraBorder}" BorderThickness="1">
          <Grid Padding="16,0,10,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE721;" FontSize="15" Foreground="{StaticResource AuroraMuted}" VerticalAlignment="Center"/>
            <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search your music, artists, albums or playlists…"
                     Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Padding="0,10"
                     KeyDown="OnSearchKeyDown" GotFocus="OnSearchFocus" LostFocus="OnSearchBlur"
                     AutomationProperties.Name="Search music">
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
              </TextBox.Resources>
            </TextBox>
            <Border x:Name="SearchHint" Grid.Column="2" Padding="8,3" CornerRadius="6" VerticalAlignment="Center"
                    Background="{StaticResource AuroraCard}">
              <TextBlock Text="Ctrl K" FontSize="11" Foreground="{StaticResource AuroraMuted}"/>
            </Border>
          </Grid>
        </Border>
        <Button x:Name="TargetButton" Grid.Column="2" Click="OnTargetButtonClick" Style="{StaticResource AuroraPillButtonStyle}"
                ToolTipService.ToolTip="Choose where music plays" AutomationProperties.Name="Playback target">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <FontIcon Glyph="&#xE7F4;" FontSize="15"/>
            <TextBlock x:Name="TargetLabel" Text="Choose a player" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource AuroraMuted}"/>
          </StackPanel>
        </Button>
      </Grid>

      <InfoBar x:Name="Message" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0,0,0,10">
        <InfoBar.ActionButton>
          <Button x:Name="SetupButton" Content="Open settings" Click="OnOpenSettings" Visibility="Collapsed"/>
        </InfoBar.ActionButton>
      </InfoBar>

      <!-- Page header: title and only the controls the current page actually needs. -->
      <StackPanel x:Name="PageHeader" Grid.Row="2" Spacing="12" Margin="0,0,0,8">
        <StackPanel Spacing="4">
          <TextBlock x:Name="ContentHeading" Text="Albums" Style="{StaticResource AuroraTitleStyle}"/>
          <TextBlock x:Name="ContentDescription" Style="{StaticResource AuroraSubtitleStyle}"/>
        </StackPanel>
        <!-- Library: move between categories without going back to the sidebar. -->
        <StackPanel x:Name="LibraryTabs" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
          <ToggleButton x:Name="TabPlaylists" Tag="playlist" Content="Playlists" Click="OnLibraryTab" Style="{StaticResource AuroraChipStyle}"/>
          <ToggleButton x:Name="TabAlbums" Tag="album" Content="Albums" Click="OnLibraryTab" Style="{StaticResource AuroraChipStyle}"/>
          <ToggleButton x:Name="TabArtists" Tag="artist" Content="Artists" Click="OnLibraryTab" Style="{StaticResource AuroraChipStyle}"/>
          <ToggleButton x:Name="TabTracks" Tag="track" Content="Tracks" Click="OnLibraryTab" Style="{StaticResource AuroraChipStyle}"/>
          <ToggleButton x:Name="TabLiked" Tag="liked" Content="Liked" Click="OnLibraryTab" Style="{StaticResource AuroraChipStyle}"/>
        </StackPanel>
        <!-- Library: filter, sort and list/grid. -->
        <Grid x:Name="LibraryToolbar" ColumnSpacing="10" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="FilterBox" Width="240" PlaceholderText="Filter this view" TextChanged="OnFilterChanged"
                   AutomationProperties.Name="Filter this view"/>
          <ComboBox x:Name="LibrarySortBox" Grid.Column="1" Width="200" PlaceholderText="Sort"
                    SelectionChanged="OnLibrarySortChanged" AutomationProperties.Name="Sort library"/>
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
            <Button x:Name="LibraryListButton" Click="OnLibraryListView" Style="{StaticResource AuroraIconButtonStyle}"
                    ToolTipService.ToolTip="List view" AutomationProperties.Name="List view">
              <FontIcon Glyph="&#xE8FD;" FontSize="15"/>
            </Button>
            <Button x:Name="LibraryGridButton" Click="OnLibraryGridView" Style="{StaticResource AuroraIconButtonStyle}"
                    ToolTipService.ToolTip="Grid view" AutomationProperties.Name="Grid view">
              <FontIcon Glyph="&#xE80A;" FontSize="15"/>
            </Button>
          </StackPanel>
        </Grid>
        <!-- Search: result-type filter. -->
        <StackPanel x:Name="SearchChips" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
          <ToggleButton x:Name="ChipAll" Tag="all" Content="All" IsChecked="True" Click="OnChipClick" Style="{StaticResource AuroraChipStyle}"/>
          <ToggleButton x:Name="ChipTracks" Tag="Track" Content="Tracks" Click="OnChipClick" Style="{StaticResource AuroraChipStyle}"/>
          <ToggleButton x:Name="ChipArtists" Tag="Artist" Content="Artists" Click="OnChipClick" Style="{StaticResource AuroraChipStyle}"/>
          <ToggleButton x:Name="ChipAlbums" Tag="Album" Content="Albums" Click="OnChipClick" Style="{StaticResource AuroraChipStyle}"/>
          <ToggleButton x:Name="ChipPlaylists" Tag="Playlist" Content="Playlists" Click="OnChipClick" Style="{StaticResource AuroraChipStyle}"/>
          <ToggleButton x:Name="ChipRadio" Tag="Radio" Content="Radio" Click="OnChipClick" Style="{StaticResource AuroraChipStyle}"/>
        </StackPanel>
      </StackPanel>

      <!-- Now playing: player, Up Next, Lyrics, Related and About in one page. -->
      <local:NowPlayingPage x:Name="NowPage" Grid.Row="2" Grid.RowSpan="2" Visibility="Collapsed"/>

      <Grid x:Name="Body" Grid.Row="3" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- Detail hero: album, artist, playlist or track. -->
        <Border x:Name="DetailHero" Grid.Row="0" Visibility="Collapsed" Background="{StaticResource AuroraHeroGradient}"
                CornerRadius="20" Padding="24">
          <Grid ColumnSpacing="26">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="176" Height="176" CornerRadius="14" Background="{StaticResource AuroraCard}" VerticalAlignment="Top">
              <Grid>
                <FontIcon Glyph="&#xE8D6;" FontSize="40" Foreground="{StaticResource AuroraMuted}" Opacity="0.5"/>
                <Image x:Name="DetailArtwork" Stretch="UniformToFill"/>
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
              <TextBlock x:Name="DetailKind" Style="{StaticResource AuroraSectionLabelStyle}" Foreground="#D4CCFF" Text="PLAYLIST"/>
              <TextBlock x:Name="DetailTitle" FontSize="32" FontWeight="Bold" Foreground="White"
                         TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2"/>
              <TextBlock x:Name="DetailByline" FontSize="14" Foreground="#D9DEF2"
                         TextTrimming="CharacterEllipsis" MaxLines="1" Visibility="Collapsed"/>
              <TextBlock x:Name="DetailStats" FontSize="12" Foreground="White" TextWrapping="Wrap" Visibility="Collapsed"/>
              <TextBlock x:Name="DetailGenres" FontSize="12" Foreground="#D9DEF2" TextWrapping="Wrap" MaxLines="2" Visibility="Collapsed"/>
              <TextBlock x:Name="DetailOverview" FontSize="12" Foreground="#D9DEF2" TextWrapping="Wrap"
                         TextTrimming="CharacterEllipsis" MaxLines="3" Visibility="Collapsed"/>
              <StackPanel x:Name="DetailActions" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button Click="OnContextPlay" Style="{StaticResource AuroraPrimaryButtonStyle}" CornerRadius="20" MinHeight="40"
                        AutomationProperties.Name="Play selection">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="13"/><TextBlock Text="Play" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Click="OnContextPlayNext" Style="{StaticResource AuroraButtonStyle}" Background="#26FFFFFF" CornerRadius="20"
                        MinHeight="40" Content="Play next"/>
                <Button Click="OnContextAdd" Style="{StaticResource AuroraButtonStyle}" Background="#26FFFFFF" CornerRadius="20"
                        MinHeight="40" Content="Add to queue"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel x:Name="DetailSection" Grid.Row="1" Spacing="4" Visibility="Collapsed">
          <TextBlock x:Name="DetailSectionTitle" FontSize="20" FontWeight="SemiBold"
                     Foreground="{StaticResource AuroraText}" Text="Tracks"/>
        </StackPanel>

        <!-- Home: greeting and real library data only. -->
        <ScrollViewer x:Name="HomeShelves" Grid.Row="2" Visibility="Collapsed" Margin="-12,0,-12,0"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="28" Padding="12,0,12,24">
            <StackPanel Spacing="4">
              <TextBlock x:Name="HomeGreeting" Text="Good day" Style="{StaticResource AuroraTitleStyle}" FontSize="36"/>
              <TextBlock x:Name="HomeSubtitle" Text="Here's your music." Style="{StaticResource AuroraSubtitleStyle}" FontSize="15"/>
            </StackPanel>
            <!-- Listening modes: each plays one of your own playlists that matches; modes without a match are not shown. -->
            <StackPanel x:Name="ModesSection" Spacing="12" Visibility="Collapsed">
              <TextBlock Text="Listening modes" Style="{StaticResource AuroraSectionTitleStyle}"/>
              <ItemsRepeater x:Name="ModesList" ItemTemplate="{StaticResource ModeTemplate}">
                <ItemsRepeater.Layout>
                  <UniformGridLayout MinItemWidth="230" MinItemHeight="68" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill"/>
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </StackPanel>
            <Grid x:Name="FeaturedGrid" ColumnSpacing="20" RowSpacing="20" Visibility="Collapsed">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <local:FeaturedCard x:Name="FeaturedOne" Visibility="Collapsed" OpenRequested="OnFeaturedOpen"
                                  PlayRequested="OnFeaturedPlay" ShuffleRequested="OnFeaturedShuffle"/>
              <local:FeaturedCard x:Name="FeaturedTwo" Grid.Column="1" Visibility="Collapsed" OpenRequested="OnFeaturedOpen"
                                  PlayRequested="OnFeaturedPlay" ShuffleRequested="OnFeaturedShuffle"/>
            </Grid>
            <local:Shelf x:Name="HomeMadeForYouShelf" Visibility="Collapsed" ItemClick="OnItemClick"
                         Title="Picked for you" RowHeight="140"/>
            <local:Shelf x:Name="HomeRecentPlaylistsShelf" Visibility="Collapsed" ItemClick="OnItemClick"
                         Title="Recently played" RowHeight="228"/>
            <local:Shelf x:Name="HomeRecentShelf" Visibility="Collapsed" ItemClick="OnItemClick"
                         Title="Continue listening" Subtitle="Albums, tracks and stations you listened to recently." RowHeight="92"/>
            <local:Shelf x:Name="HomeRotationShelf" Visibility="Collapsed" ItemClick="OnItemClick" ShowAll="OnShelfShowAll"
                         ShowAllTarget="playlist"/>
            <local:Shelf x:Name="HomeTopAlbumsShelf" Visibility="Collapsed" ItemClick="OnItemClick" ShowAll="OnShelfShowAll"
                         ShowAllTarget="album" Title="Albums you play most" Subtitle="Ranked by your play counts."/>
            <local:Shelf x:Name="HomeTopArtistsShelf" Visibility="Collapsed" ItemClick="OnItemClick" ShowAll="OnShelfShowAll"
                         ShowAllTarget="artist" Title="Your top artists" Subtitle="The artists you play most."/>
            <local:Shelf x:Name="HomeNewAlbumsShelf" Visibility="Collapsed" ItemClick="OnItemClick" ShowAll="OnShelfShowAll"
                         ShowAllTarget="album" Title="New in your library" Subtitle="Albums most recently added."/>
            <local:Shelf x:Name="HomeNewPlaylistsShelf" Visibility="Collapsed" ItemClick="OnItemClick" ShowAll="OnShelfShowAll"
                         ShowAllTarget="playlist" Title="Recently added playlists" Subtitle="Fresh additions to your playlists."/>
            <local:Shelf x:Name="HomeRadioShelf" Visibility="Collapsed" ItemClick="OnItemClick" ShowAll="OnShelfShowAll"
                         ShowAllTarget="radio" Title="Radio stations" Subtitle="Live stations from your library."/>
          </StackPanel>
        </ScrollViewer>

        <!-- Discover: insight, explore tiles, statistics and shelves. Every section is built from Music Assistant data and hidden when there is none. -->
        <ScrollViewer x:Name="DiscoverView" Grid.Row="2" Visibility="Collapsed" Margin="-12,0,-12,0"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="36" Padding="12,0,12,32">
            <Border x:Name="InsightPanel" Style="{StaticResource AuroraPanelStyle}" Visibility="Collapsed">
              <Grid ColumnSpacing="22">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="60" Height="60" CornerRadius="19" Background="{StaticResource AuroraAccentGradient}" VerticalAlignment="Center">
                  <FontIcon Glyph="&#xE735;" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                  <TextBlock x:Name="InsightTitle" Text="Your music insight" Style="{StaticResource AuroraSectionTitleStyle}"/>
                  <TextBlock x:Name="InsightDetail" FontSize="14" Foreground="#D6D3E8" TextWrapping="Wrap" MaxLines="3"/>
                  <TextBlock Text="Based on your library tags, play counts and listening history. Not AI-generated." Style="{StaticResource AuroraMetaStyle}"/>
                </StackPanel>
                <StackPanel x:Name="InsightArtists" Grid.Column="2" Orientation="Horizontal" Spacing="-10" VerticalAlignment="Center"/>
              </Grid>
            </Border>

            <StackPanel x:Name="ExploreSection" Spacing="12" Visibility="Collapsed">
              <TextBlock Text="More to explore" Style="{StaticResource AuroraSectionTitleStyle}"/>
              <ItemsRepeater x:Name="ExploreTiles" ItemTemplate="{StaticResource ExploreTileTemplate}">
                <ItemsRepeater.Layout>
                  <UniformGridLayout MinItemWidth="210" MinItemHeight="104" MinColumnSpacing="14" MinRowSpacing="14" ItemsStretch="Fill"/>
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </StackPanel>

            <local:Shelf x:Name="DiscoverBecauseShelf" Visibility="Collapsed" ItemClick="OnItemClick"/>
            <local:Shelf x:Name="DiscoverSimilarShelf" Visibility="Collapsed" ItemClick="OnItemClick"/>
            <local:Shelf x:Name="DiscoverNewShelf" Visibility="Collapsed" ItemClick="OnItemClick" ShowAll="OnShelfShowAll"
                         ShowAllTarget="album" Title="New releases in your library" Subtitle="Albums most recently added to Music Assistant."/>

            <StackPanel x:Name="GenreSection" Spacing="12" Visibility="Collapsed">
              <TextBlock Text="Explore genres" Style="{StaticResource AuroraSectionTitleStyle}"/>
              <TextBlock Text="Genres your albums are tagged with. Pick one to see its albums." Style="{StaticResource AuroraSubtitleStyle}"/>
              <ItemsRepeater x:Name="GenreChips" ItemTemplate="{StaticResource GenreChipTemplate}">
                <ItemsRepeater.Layout>
                  <UniformGridLayout MinItemWidth="170" MinItemHeight="44" MinColumnSpacing="10" MinRowSpacing="10" ItemsStretch="Fill"/>
                </ItemsRepeater.Layout>
              </ItemsRepeater>
              <local:Shelf x:Name="DiscoverGenreShelf" Visibility="Collapsed" ItemClick="OnItemClick"/>
            </StackPanel>

            <Border x:Name="StatsPanel" Style="{StaticResource AuroraCardStyle}" Visibility="Collapsed">
              <StackPanel Spacing="14">
                <TextBlock Text="Listening statistics" Style="{StaticResource AuroraSectionTitleStyle}"/>
                <ItemsRepeater x:Name="StatsList" ItemTemplate="{StaticResource StatTileTemplate}">
                  <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="190" MinItemHeight="96" MinColumnSpacing="14" MinRowSpacing="14" ItemsStretch="Fill"/>
                  </ItemsRepeater.Layout>
                </ItemsRepeater>
                <TextBlock Text="Counted from Music Assistant's recently played list and your library's play counts." Style="{StaticResource AuroraMetaStyle}"/>
              </StackPanel>
            </Border>

            <local:Shelf x:Name="DiscoverUndiscoveredShelf" Visibility="Collapsed" ItemClick="OnItemClick" ShowAll="OnShelfShowAll"
                         ShowAllTarget="album" Title="Music you haven't discovered yet" Subtitle="Albums in your library you haven't played."/>
          </StackPanel>
        </ScrollViewer>

        <!-- Library, playlists, artists: a virtualised grid of cards. -->
        <GridView x:Name="AlbumGrid" Grid.Row="2" IsItemClickEnabled="True" SelectionMode="None" Margin="-12,0,-12,0" SizeChanged="OnAlbumGridSizeChanged"
                  ItemClick="OnItemClick" Visibility="Collapsed" ItemTemplate="{StaticResource CardTemplate}"
                  ItemContainerStyle="{StaticResource AuroraGridItemStyle}" HorizontalContentAlignment="Stretch"
                  Padding="0,0,0,16" AutomationProperties.Name="Library grid"/>

        <ListView x:Name="List" Grid.Row="2" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnItemClick"
                  ItemTemplate="{StaticResource RowTemplate}" ItemContainerStyle="{StaticResource AuroraListItemStyle}"
                  Margin="-10,0,-10,0" Padding="0,0,0,16" AutomationProperties.Name="Library and queue items"/>

        <!-- Loading, empty and error surfaces. -->
        <StackPanel x:Name="LoadingState" Grid.Row="2" Visibility="Collapsed" Spacing="22"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top" Padding="0,8,0,0"
                    AutomationProperties.LiveSetting="Polite">
          <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <ProgressRing x:Name="Busy" IsActive="False" Width="24" Height="24"
                          Foreground="{StaticResource AuroraAccent}" AutomationProperties.Name="Loading music"/>
            <TextBlock x:Name="LoadingLabel" Text="Loading your music…" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource AuroraText}" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="SkeletonRow" Orientation="Horizontal" Spacing="16">
            <StackPanel Spacing="10" Width="164"><Border Height="164" CornerRadius="10" Background="{StaticResource AuroraCardSoft}"/><Border Height="10" Width="120" HorizontalAlignment="Left" CornerRadius="5" Background="{StaticResource AuroraCardSoft}"/><Border Height="8" Width="80" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource AuroraCardSoft}"/></StackPanel>
            <StackPanel Spacing="10" Width="164"><Border Height="164" CornerRadius="10" Background="{StaticResource AuroraCardSoft}"/><Border Height="10" Width="100" HorizontalAlignment="Left" CornerRadius="5" Background="{StaticResource AuroraCardSoft}"/><Border Height="8" Width="90" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource AuroraCardSoft}"/></StackPanel>
            <StackPanel Spacing="10" Width="164"><Border Height="164" CornerRadius="10" Background="{StaticResource AuroraCardSoft}"/><Border Height="10" Width="130" HorizontalAlignment="Left" CornerRadius="5" Background="{StaticResource AuroraCardSoft}"/><Border Height="8" Width="70" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource AuroraCardSoft}"/></StackPanel>
            <StackPanel Spacing="10" Width="164"><Border Height="164" CornerRadius="10" Background="{StaticResource AuroraCardSoft}"/><Border Height="10" Width="110" HorizontalAlignment="Left" CornerRadius="5" Background="{StaticResource AuroraCardSoft}"/><Border Height="8" Width="84" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource AuroraCardSoft}"/></StackPanel>
          </StackPanel>
        </StackPanel>
        <Border x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Center"
                VerticalAlignment="Center" MaxWidth="420" Padding="32,26" CornerRadius="20"
                Background="{StaticResource AuroraCardSoft}" BorderBrush="{StaticResource AuroraBorder}" BorderThickness="1">
          <StackPanel Spacing="11" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE8D6;" FontSize="30" Foreground="{StaticResource AuroraAccent}" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyText" Text="Nothing here yet" FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource AuroraText}" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="EmptyDetail" Text="Your music will appear here." Style="{StaticResource AuroraStatusTextStyle}"
                       MaxWidth="320" TextAlignment="Center"/>
            <Button x:Name="RetryButton" Content="Try again" Visibility="Collapsed" Click="OnRetry"
                    HorizontalAlignment="Center" Margin="0,6,0,0"
                    Style="{StaticResource AuroraPrimaryButtonStyle}" AutomationProperties.Name="Retry loading music"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- Playback bar: track, transport and progress, output options. Always visible, full width. -->
    <Border x:Name="PlayerBar" Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource AuroraPlayerBar}"
            BorderBrush="{StaticResource AuroraBorder}" BorderThickness="0,1,0,0">
      <Grid Padding="20,10" ColumnSpacing="20" MinHeight="92">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="150"/><ColumnDefinition Width="2*" MaxWidth="640"/><ColumnDefinition Width="*" MinWidth="120"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" ColumnSpacing="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button Tag="now" Click="OnNavigate" Style="{StaticResource AuroraButtonStyle}" Padding="0" CornerRadius="10"
                  BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                  ToolTipService.ToolTip="Open now playing" AutomationProperties.Name="Open now playing">
            <Border Width="60" Height="60" CornerRadius="10" Background="{StaticResource AuroraHeroGradient}">
              <Grid>
                <FontIcon Glyph="&#xE8D6;" Foreground="{StaticResource AuroraMuted}" Opacity="0.6"/>
                <Image x:Name="FooterArtwork" Stretch="UniformToFill"/>
              </Grid>
            </Border>
          </Button>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="FooterTitle" Text="Nothing playing" Foreground="{StaticResource AuroraText}" FontSize="14"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
            <TextBlock x:Name="FooterArtist" Text="Choose a player" Style="{StaticResource AuroraSubtitleStyle}" FontSize="12" MaxLines="1"/>
            <TextBlock x:Name="FooterState" Text="Idle" AutomationProperties.LiveSetting="Polite" Foreground="{StaticResource AuroraGood}"
                       FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="1"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
            <Button x:Name="FooterMoreButton" Click="OnFooterMore" Style="{StaticResource AuroraIconButtonStyle}"
                    ToolTipService.ToolTip="More options" AutomationProperties.Name="More options">
              <FontIcon Glyph="&#xE712;" FontSize="15"/>
            </Button>
          </StackPanel>
        </Grid>

        <Grid Grid.Column="1" RowSpacing="4" VerticalAlignment="Center">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <Button x:Name="FooterShuffleButton" Click="OnFooterShuffle" ToolTipService.ToolTip="Shuffle" IsEnabled="False"
                    AutomationProperties.Name="Toggle shuffle" Style="{StaticResource AuroraIconButtonStyle}">
              <FontIcon x:Name="FooterShuffleIcon" Glyph="&#xE8B1;" FontSize="15"/>
            </Button>
            <Button x:Name="FooterPreviousButton" Click="OnQueuePrevious" ToolTipService.ToolTip="Previous"
                    AutomationProperties.Name="Previous" Style="{StaticResource AuroraIconButtonStyle}" Foreground="{StaticResource AuroraText}">
              <FontIcon Glyph="&#xE892;" FontSize="16"/>
            </Button>
            <Button x:Name="FooterPlayPauseButton" Click="OnQueuePlayPause" ToolTipService.ToolTip="Play or pause"
                    AutomationProperties.Name="Play or pause" Style="{StaticResource AuroraPlayButtonStyle}">
              <Grid Width="28" Height="28">
                <Ellipse x:Name="FooterPlayPauseTrack" Visibility="Collapsed" Width="26" Height="26"
                         Stroke="#B3A8FF" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <FontIcon x:Name="FooterPlayPauseIcon" Glyph="&#xE768;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ProgressRing x:Name="FooterPlayPauseSpinner" IsActive="False" Visibility="Collapsed"
                              Foreground="White" Width="28" Height="28"/>
              </Grid>
            </Button>
            <Button x:Name="FooterNextButton" Click="OnQueueNext" ToolTipService.ToolTip="Next"
                    AutomationProperties.Name="Next" Style="{StaticResource AuroraIconButtonStyle}" Foreground="{StaticResource AuroraText}">
              <FontIcon Glyph="&#xE893;" FontSize="16"/>
            </Button>
            <Button x:Name="FooterRepeatButton" Click="OnFooterRepeat" ToolTipService.ToolTip="Repeat" IsEnabled="False"
                    AutomationProperties.Name="Cycle repeat mode" Style="{StaticResource AuroraIconButtonStyle}">
              <FontIcon x:Name="FooterRepeatIcon" Glyph="&#xE8EE;" FontSize="15"/>
            </Button>
          </StackPanel>
          <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterElapsed" Text="0:00" FontSize="11" Foreground="{StaticResource AuroraMuted}"
                       VerticalAlignment="Center" TextAlignment="Right"/>
            <Slider x:Name="FooterSeekSlider" Grid.Column="1" Minimum="0" Maximum="1" IsEnabled="False"
                    IsThumbToolTipEnabled="False" ValueChanged="OnFooterSeekChanged"
                    AutomationProperties.Name="Track position" VerticalAlignment="Center"/>
            <TextBlock x:Name="FooterDuration" Grid.Column="2" Text="—" FontSize="11"
                       Foreground="{StaticResource AuroraMuted}" VerticalAlignment="Center"/>
          </Grid>
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
          <Button x:Name="FooterDeviceButton" Click="OnTargetButtonClick" Style="{StaticResource AuroraIconButtonStyle}"
                  ToolTipService.ToolTip="Output device" AutomationProperties.Name="Choose output device">
            <FontIcon Glyph="&#xE7F4;" FontSize="16"/>
          </Button>
          <StackPanel x:Name="FooterVolumeGroup" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button x:Name="FooterMuteButton" Click="OnFooterMute" ToolTipService.ToolTip="Mute or unmute"
                    AutomationProperties.Name="Mute or unmute" Style="{StaticResource AuroraIconButtonStyle}">
              <FontIcon x:Name="FooterMuteIcon" Glyph="&#xE767;" FontSize="16"/>
            </Button>
            <Slider x:Name="FooterVolumeSlider" Width="104" Minimum="0" Maximum="100" IsEnabled="False"
                    ValueChanged="OnFooterVolumeChanged" AutomationProperties.Name="Player volume"
                    VerticalAlignment="Center"/>
          </StackPanel>
          <Button x:Name="FooterQueueButton" Click="OnOpenQueue" Style="{StaticResource AuroraIconButtonStyle}"
                  ToolTipService.ToolTip="Open Up Next" AutomationProperties.Name="Open Up Next">
            <FontIcon Glyph="&#xE8FD;" FontSize="16"/>
          </Button>
          <Button x:Name="FooterExpandButton" Tag="now" Click="OnNavigate" Style="{StaticResource AuroraIconButtonStyle}"
                  ToolTipService.ToolTip="Open now playing" AutomationProperties.Name="Expand now playing">
            <FontIcon x:Name="FooterExpandIcon" Glyph="&#xE70E;" FontSize="15"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
