<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="MaSatellite.App.Views.Shelf"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A Spotify-style horizontal shelf: scrolls only through the chevron buttons, never the mouse wheel. -->
  <StackPanel Spacing="4">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="2">
        <TextBlock x:Name="TitleText" Foreground="{StaticResource AuroraText}" FontSize="20" FontWeight="Bold"/>
        <TextBlock x:Name="SubtitleText" Style="{StaticResource AuroraSubtitleStyle}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button x:Name="PreviousButton" Click="OnPrevious" Style="{StaticResource AuroraButtonStyle}"
                Width="34" Height="34" MinHeight="34" Padding="0" CornerRadius="17"
                ToolTipService.ToolTip="Scroll left" AutomationProperties.Name="Scroll left">
          <FontIcon Glyph="&#xE76B;" FontSize="13"/>
        </Button>
        <Button x:Name="NextButton" Click="OnNext" Style="{StaticResource AuroraButtonStyle}"
                Width="34" Height="34" MinHeight="34" Padding="0" CornerRadius="17"
                ToolTipService.ToolTip="Scroll right" AutomationProperties.Name="Scroll right">
          <FontIcon Glyph="&#xE76C;" FontSize="13"/>
        </Button>
      </StackPanel>
    </Grid>
    <GridView x:Name="Items" Height="284" IsItemClickEnabled="True" SelectionMode="None"
              ItemClick="OnItemClicked" SizeChanged="OnItemsSizeChanged"
              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
      <GridView.ItemsPanel>
        <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
      </GridView.ItemsPanel>
    </GridView>
  </StackPanel>
</UserControl>
