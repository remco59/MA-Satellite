<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="MaSatellite.App.Views.Shelf"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A horizontal row of cards. It scrolls only through the chevron buttons, never the mouse wheel. -->
  <StackPanel Spacing="6">
    <Grid ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Spacing="2">
        <TextBlock x:Name="TitleText" Foreground="{StaticResource AuroraText}" FontSize="22" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="SubtitleText" Style="{StaticResource AuroraSubtitleStyle}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button x:Name="ShowAllButton" Click="OnShowAll" Visibility="Collapsed" Style="{StaticResource AuroraButtonStyle}"
                Background="Transparent" BorderThickness="0" Foreground="{StaticResource AuroraMuted}" MinHeight="32"
                Padding="10,4" Margin="0,0,6,0" AutomationProperties.Name="Show all">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Show all" FontSize="13" VerticalAlignment="Center"/>
            <FontIcon Glyph="&#xE76C;" FontSize="11"/>
          </StackPanel>
        </Button>
        <Button x:Name="PreviousButton" Click="OnPrevious" Style="{StaticResource AuroraIconButtonStyle}"
                Width="32" Height="32" MinHeight="32" CornerRadius="16"
                ToolTipService.ToolTip="Scroll left" AutomationProperties.Name="Scroll left">
          <FontIcon Glyph="&#xE76B;" FontSize="12"/>
        </Button>
        <Button x:Name="NextButton" Click="OnNext" Style="{StaticResource AuroraIconButtonStyle}"
                Width="32" Height="32" MinHeight="32" CornerRadius="16"
                ToolTipService.ToolTip="Scroll right" AutomationProperties.Name="Scroll right">
          <FontIcon Glyph="&#xE76C;" FontSize="12"/>
        </Button>
      </StackPanel>
    </Grid>
    <GridView x:Name="Items" Height="252" IsItemClickEnabled="True" SelectionMode="None"
              ItemContainerStyle="{StaticResource AuroraGridItemStyle}"
              ItemClick="OnItemClicked" SizeChanged="OnItemsSizeChanged"
              ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
              ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
      <GridView.ItemsPanel>
        <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
      </GridView.ItemsPanel>
    </GridView>
  </StackPanel>
</UserControl>
