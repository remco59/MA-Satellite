<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Aurora 3.0: near-black charcoal with indigo undertones, violet accent, quiet borders. All colours, type and spacing tokens live here. -->

  <!-- Surfaces -->
  <SolidColorBrush x:Key="AuroraBackground" Color="#0A0A12"/>
  <SolidColorBrush x:Key="AuroraSidebar" Color="#0D0D17"/>
  <SolidColorBrush x:Key="AuroraPlayerBar" Color="#0C0C16"/>
  <SolidColorBrush x:Key="AuroraCard" Color="#1C1B33"/>
  <SolidColorBrush x:Key="AuroraCardSoft" Color="#131320"/>
  <SolidColorBrush x:Key="AuroraSurfaceRaised" Color="#1A1A2E"/>
  <SolidColorBrush x:Key="AuroraAccentSoft" Color="#2E2760"/>
  <SolidColorBrush x:Key="AuroraInput" Color="#151526"/>
  <SolidColorBrush x:Key="AuroraBorder" Color="#24233A"/>

  <!-- Text -->
  <SolidColorBrush x:Key="AuroraText" Color="#F4F3FA"/>
  <SolidColorBrush x:Key="AuroraMuted" Color="#9C99B4"/>

  <!-- Accent and status -->
  <SolidColorBrush x:Key="AuroraAccent" Color="#A78BFA"/>
  <SolidColorBrush x:Key="AuroraGood" Color="#42DFBB"/>
  <SolidColorBrush x:Key="AuroraHover" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="AuroraSelected" Color="#2A2556"/>
  <LinearGradientBrush x:Key="AuroraAccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#8B5CF6" Offset="0"/>
    <GradientStop Color="#6366F1" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AuroraHeroGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#2A2060" Offset="0"/>
    <GradientStop Color="#44246E" Offset="0.6"/>
    <GradientStop Color="#1C2866" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AuroraSidebarGradient" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#10101E" Offset="0"/>
    <GradientStop Color="#0B0B15" Offset="1"/>
  </LinearGradientBrush>
  <!-- Text-protection scrim over artwork on featured cards. -->
  <LinearGradientBrush x:Key="AuroraScrim" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Color="#F00A0A12" Offset="0"/>
    <GradientStop Color="#B00A0A12" Offset="0.5"/>
    <GradientStop Color="#000A0A12" Offset="1"/>
  </LinearGradientBrush>

  <!-- Shape tokens -->
  <CornerRadius x:Key="AuroraRadiusS">8</CornerRadius>
  <CornerRadius x:Key="AuroraRadiusM">12</CornerRadius>
  <CornerRadius x:Key="AuroraRadiusL">16</CornerRadius>
  <CornerRadius x:Key="AuroraRadiusXL">24</CornerRadius>
  <x:Double x:Key="AuroraPagePadding">32</x:Double>

  <!-- Spacing scale (4-pt grid). Pages use M between related items and XL between sections. -->
  <x:Double x:Key="AuroraSpaceS">8</x:Double>
  <x:Double x:Key="AuroraSpaceM">16</x:Double>
  <x:Double x:Key="AuroraSpaceL">24</x:Double>
  <x:Double x:Key="AuroraSpaceXL">36</x:Double>

  <!-- Atmosphere: two soft tints used behind hero areas and the Now Playing backdrop. -->
  <Color x:Key="AuroraGlowViolet">#7C3AED</Color>
  <Color x:Key="AuroraGlowMagenta">#C026D3</Color>
  <Color x:Key="AuroraGlowBlue">#2563EB</Color>
  <LinearGradientBrush x:Key="AuroraAtmosphereGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#40351E8A" Offset="0"/>
    <GradientStop Color="#2A7C1D8F" Offset="0.55"/>
    <GradientStop Color="#000A0A12" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AuroraNowGlow" StartPoint="1,0" EndPoint="0,1">
    <GradientStop Color="#55C026D3" Offset="0"/>
    <GradientStop Color="#003B1E8A" Offset="0.7"/>
  </LinearGradientBrush>
  <!-- Fades the Now Playing backdrop into the page background at the bottom. -->
  <LinearGradientBrush x:Key="AuroraBackdropFade" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#000A0A12" Offset="0"/>
    <GradientStop Color="#CC0A0A12" Offset="1"/>
  </LinearGradientBrush>

  <!-- Sliders follow the Aurora accent instead of the Windows accent colour. -->
  <SolidColorBrush x:Key="SliderTrackFill" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#33FFFFFF"/>
  <SolidColorBrush x:Key="SliderTrackValueFill" Color="#A78BFA"/>
  <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#C4B5FD"/>
  <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#A78BFA"/>
  <SolidColorBrush x:Key="SliderThumbBackground" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#E6E3FF"/>

  <!-- Text styles -->
  <Style x:Key="AuroraTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="32"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource AuroraText}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <!-- Type hierarchy: page title 32, section 22, item title 14/semibold, body 13, meta 12 (nothing smaller than 11). -->
  <Style x:Key="AuroraSectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource AuroraText}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="AuroraItemTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource AuroraText}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="AuroraMetaStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource AuroraMuted}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="AuroraSubtitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource AuroraMuted}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="AuroraStatusTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{StaticResource AuroraMuted}"/>
  </Style>
  <Style x:Key="AuroraSectionLabelStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AuroraMuted}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CharacterSpacing" Value="100"/>
  </Style>
  <Style x:Key="AuroraCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource AuroraCardSoft}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AuroraBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="18"/>
  </Style>
  <!-- A raised surface for hero panels: a faint violet-to-charcoal gradient instead of a flat fill. -->
  <Style x:Key="AuroraPanelStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource AuroraAtmosphereGradient}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AuroraBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="22"/>
    <Setter Property="Padding" Value="24"/>
  </Style>

  <!--
    One button template for every Aurora button. A translucent white overlay provides hover and pressed
    feedback on top of whatever background the style sets (solid, gradient or transparent).
  -->
  <ControlTemplate x:Key="AuroraButtonTemplate" TargetType="Button">
    <Grid x:Name="RootGrid">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"/>
      <Border x:Name="Overlay" Background="White" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
      <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                        Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        AutomationProperties.AccessibilityView="Raw"/>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="PointerOver">
            <VisualState.Setters><Setter Target="Overlay.Opacity" Value="0.10"/></VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters><Setter Target="Overlay.Opacity" Value="0.18"/></VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Disabled">
            <VisualState.Setters><Setter Target="ContentPresenter.Opacity" Value="0.38"/></VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <!-- Navigation item with a leading accent bar when selected. -->
  <ControlTemplate x:Key="AuroraNavSelectedTemplate" TargetType="Button">
    <Grid x:Name="RootGrid">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"/>
      <Border x:Name="Overlay" Background="White" Opacity="0" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False"/>
      <Border Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
              Margin="0" Background="{StaticResource AuroraAccent}"/>
      <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                        Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Overlay.Opacity" Value="0.06"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Overlay.Opacity" Value="0.12"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ContentPresenter.Opacity" Value="0.38"/></VisualState.Setters></VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </ControlTemplate>

  <Style x:Key="AuroraButtonStyle" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource AuroraButtonTemplate}"/>
    <Setter Property="Background" Value="{StaticResource AuroraSurfaceRaised}"/>
    <Setter Property="Foreground" Value="{StaticResource AuroraText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AuroraBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="UseSystemFocusVisuals" Value="True"/>
  </Style>
  <Style x:Key="AuroraPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AuroraButtonStyle}">
    <Setter Property="Background" Value="{StaticResource AuroraAccentGradient}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="Padding" Value="18,9"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <!-- Round, borderless icon button used for secondary transport and chrome controls. -->
  <Style x:Key="AuroraIconButtonStyle" TargetType="Button" BasedOn="{StaticResource AuroraButtonStyle}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource AuroraMuted}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <!-- The prominent round play/pause button. -->
  <Style x:Key="AuroraPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource AuroraPrimaryButtonStyle}">
    <Setter Property="CornerRadius" Value="28"/>
    <Setter Property="Width" Value="52"/>
    <Setter Property="Height" Value="52"/>
    <Setter Property="MinHeight" Value="52"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style x:Key="AuroraPillButtonStyle" TargetType="Button" BasedOn="{StaticResource AuroraButtonStyle}">
    <Setter Property="Background" Value="{StaticResource AuroraInput}"/>
    <Setter Property="CornerRadius" Value="22"/>
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Padding" Value="16,0"/>
  </Style>
  <!-- A transparent full-surface hit target, used behind the content of clickable cards. -->
  <Style x:Key="AuroraSurfaceButtonStyle" TargetType="Button" BasedOn="{StaticResource AuroraButtonStyle}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style x:Key="AuroraNavButtonStyle" TargetType="Button" BasedOn="{StaticResource AuroraButtonStyle}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource AuroraMuted}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="AuroraNavSelectedButtonStyle" TargetType="Button" BasedOn="{StaticResource AuroraNavButtonStyle}">
    <Setter Property="Template" Value="{StaticResource AuroraNavSelectedTemplate}"/>
    <Setter Property="Background" Value="{StaticResource AuroraSelected}"/>
    <Setter Property="Foreground" Value="{StaticResource AuroraText}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- Filter chip (search result types). -->
  <Style x:Key="AuroraChipStyle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource AuroraMuted}"/>
    <Setter Property="Background" Value="{StaticResource AuroraInput}"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="16"/>
            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                              Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              AutomationProperties.AccessibilityView="Raw"/>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal"/>
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Surface.Background" Value="{StaticResource AuroraCard}"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Surface.Background" Value="{StaticResource AuroraAccentSoft}"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="ContentPresenter.Opacity" Value="0.38"/></VisualState.Setters></VisualState>
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Surface.Background" Value="{StaticResource AuroraSelected}"/>
                    <Setter Target="ContentPresenter.Foreground" Value="{StaticResource AuroraText}"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Surface.Background" Value="{StaticResource AuroraSelected}"/>
                    <Setter Target="ContentPresenter.Foreground" Value="{StaticResource AuroraText}"/>
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Surface.Background" Value="{StaticResource AuroraAccentSoft}"/>
                    <Setter Target="ContentPresenter.Foreground" Value="{StaticResource AuroraText}"/>
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Item containers for card grids and lists: no built-in selection or hover chrome. Each card draws its own
    hover state, so the container only needs to host content and keep keyboard focus.
  -->
  <Style x:Key="AuroraGridItemStyle" TargetType="GridViewItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridViewItem">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AuroraListItemStyle" TargetType="ListViewItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
