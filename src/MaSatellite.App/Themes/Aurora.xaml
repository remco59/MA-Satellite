<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dark Aurora: accessible contrasts, one accent and a restrained gradient language. -->
  <SolidColorBrush x:Key="AuroraBackground" Color="#0E1524"/>
  <SolidColorBrush x:Key="AuroraSidebar" Color="#10192B"/>
  <SolidColorBrush x:Key="AuroraCard" Color="#1B2940"/>
  <SolidColorBrush x:Key="AuroraCardSoft" Color="#172237"/>
  <SolidColorBrush x:Key="AuroraInput" Color="#202D43"/>
  <SolidColorBrush x:Key="AuroraBorder" Color="#304057"/>
  <SolidColorBrush x:Key="AuroraText" Color="#F5F7FF"/>
  <SolidColorBrush x:Key="AuroraMuted" Color="#A1B0C9"/>
  <SolidColorBrush x:Key="AuroraAccent" Color="#86ABFF"/>
  <SolidColorBrush x:Key="AuroraGood" Color="#42DFBB"/>
  <LinearGradientBrush x:Key="AuroraAccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#76BDFF" Offset="0"/>
    <GradientStop Color="#9B83FF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AuroraHeroGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#2A345E" Offset="0"/>
    <GradientStop Color="#473068" Offset="0.58"/>
    <GradientStop Color="#214768" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AuroraSidebarGradient" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Color="#15213A" Offset="0"/>
    <GradientStop Color="#0F1728" Offset="1"/>
  </LinearGradientBrush>
  <Style x:Key="AuroraTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource AuroraText}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="AuroraSubtitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource AuroraMuted}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="AuroraCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource AuroraCardSoft}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AuroraBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="16"/>
  </Style>
  <Style x:Key="AuroraButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource AuroraCard}"/>
    <Setter Property="Foreground" Value="{StaticResource AuroraText}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AuroraBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="14,8"/>
  </Style>
  <Style x:Key="AuroraPrimaryButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource AuroraAccentGradient}"/>
    <Setter Property="Foreground" Value="#10192B"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="Padding" Value="18,9"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="AuroraNavButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource AuroraMuted}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="15,12"/>
    <Setter Property="MinHeight" Value="43"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="AuroraSectionLabelStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AuroraMuted}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="CharacterSpacing" Value="110"/>
  </Style>
</ResourceDictionary>